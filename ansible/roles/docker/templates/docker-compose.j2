services:
  mysql:
    image: {{ docker_mysql_image }}
    container_name: mysql
    volumes:
      - mysql:/var/lib/mysql
    expose:
      - 3306
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p{{ mysql_root_password }} --silent"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - docker-network
    restart: always
    environment:
      MYSQL_DATABASE: {{ mysql_name }}
      MYSQL_USER: {{ mysql_user }}
      MYSQL_PASSWORD: {{ mysql_user_password }}
  nginx:
    image: {{ docker_nginx_image }}
    container_name: nginx
    depends_on:
      wordpress:
        condition: service_healthy
    volumes:
      - wordpress:/var/www/html
    ports:
      - 443:443
    networks:
      - docker-network
    environment:
   - NGINX_HOST= {{ domain_name }}
   - NGINX_PORT=443
    restart: always
  wordpress:
    image: {{ docker_wordpress_image }}
    container_name: wordpress
    depends_on:
      mysql:
        condition: service_healthy
    environment:
      - WORDPRESS_DB_HOST={{ mysql_host }}
      - WORDPRESS_DB_NAME={{ mysql_name }}
      - WORDPRESS_DB_USER={{ mysql_user }}
      - WORDPRESS_DB_PASSWORD={{ mysql_user_password }}
    volumes:
      - wordpress:/var/www/html
    expose:
      - 9000
    healthcheck:
      test: ["CMD-SHELL", "php -r 'exit(@fsockopen(\"127.0.0.1\", 9000) ? 0 : 1);'"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - docker-network
    restart: always

volumes:
  wordpress:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{ docker_volume_directories_wordpress }}
  mysql:
    driver: local
    driver_opts:
      o: bind
      type: none
      device: {{ docker_volume_directories_database }}

networks:
  docker-network:
    driver: bridge

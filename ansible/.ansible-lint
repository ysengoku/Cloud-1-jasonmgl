---
profile: production

exclude_paths:
  - .cache/
  - .git/
  - molecule/
  - tests/

skip_list: []                          # règles ignorées (avec justification)

warn_list:
  - experimental                       # règles expérimentales en warn
  - role-name                          # autorise les '-' dans noms (Galaxy)

use_default_rules: true
verbosity: 1

enable_list:
  - args
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - yaml
  